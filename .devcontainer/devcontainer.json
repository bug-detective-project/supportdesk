{
  "name": "SupportDesk",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "postCreateCommand": "npm ci && npm run db:reset",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": { "label": "SupportDesk client", "onAutoForward": "openBrowser" },
    "3001": { "label": "SupportDesk API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vitest.explorer"]
    }
  }
}
