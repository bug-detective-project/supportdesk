{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:reset": "node src/scripts/reset-db.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
